@prefix brreg_felles_digital_adresse: <https://data.norge.no/felles/brreg-felles-digital-adresse/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

xsd:base64Binary a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:gYear a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

xsd:hexBinary a rdfs:Datatype .

xsd:integer a rdfs:Datatype .

xsd:long a rdfs:Datatype .

xsd:negativeInteger a rdfs:Datatype .

xsd:nonNegativeInteger a rdfs:Datatype .

xsd:nonPositiveInteger a rdfs:Datatype .

xsd:positiveInteger a rdfs:Datatype .

xsd:short a rdfs:Datatype .

xsd:token a rdfs:Datatype .

<https://data.norge.no/felles/brreg-felles-digital-adresse.owl.ttl> a owl:Ontology ;
    rdfs:label "brreg-felles-digital-adresse" ;
    dcterms:license "https://data.norge.no/nlod/no/2.0" ;
    dcterms:title "BRREG felles digital adresse" ;
    pav:version "0.1.0" ;
    skos:definition """Gjenbrukbare digitale adresseklassar utleia frå Brønnøysundregistrene (BR) sin interne BRReferansemodell_v3 (MagicDraw/XMI), pakken "Adresse" (DigitalAdresse-hierarkiet). Sjå specs/done/felles-typar-enhetsregisteret-fra-br-katalogar.md for bakgrunn, metode og avklaringane denne modellen byggjer på.
BR sin eigen `Nettadresse`-undertype "Aksesspunkt" er medvite utelaten her: feltet `aksesspunktoperatoer` peikar til `Virksomhet` (definert i brreg-felles-aktoer, som importerer denne modellen) og ville gjort importgrafen sirkulær. Sjå nemnde spec § Funn 4.""" ;
    brreg_felles_digital_adresse:endringsdato "2026-09-01" ;
    brreg_felles_digital_adresse:status "http://purl.org/adms/status/UnderDevelopment" ;
    brreg_felles_digital_adresse:utgivelsesdato "2026-09-01" ;
    brreg_felles_digital_adresse:utgiver "https://data.norge.no/organizations/974760673" .

xsd:anyURI a rdfs:Datatype .

brreg_felles_digital_adresse:EPostadresse a owl:Class ;
    rdfs:label "EPostadresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:brukernavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:domenenavn ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Ei e-postadresse, delt opp i brukarnamn og domenenavn." ;
    skos:exactMatch brreg_felles_digital_adresse:EPostadresse ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:IPAdresse a owl:Class ;
    rdfs:label "IPAdresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:ip_nummer ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Ei IP-adresse." ;
    skos:exactMatch brreg_felles_digital_adresse:IPAdresse ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:Meldingsboks a owl:Class ;
    rdfs:label "Meldingsboks" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:meldingsbokstype ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Ei digital meldingsboks (t.d. Altinn)." ;
    skos:exactMatch brreg_felles_digital_adresse:Meldingsboks ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:Mobiltelefonnummer a owl:Class ;
    rdfs:label "Mobiltelefonnummer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:nasjonalt_nummer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:prefiks_med_nasjonal_kode ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Eit mobiltelefonnummer." ;
    skos:exactMatch brreg_felles_digital_adresse:Mobiltelefonnummer ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:Nettadresse a owl:Class ;
    rdfs:label "Nettadresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:filsti ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:domenenavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:protokoll ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Ei nettadresse (protokoll, domenenavn og filsti)." ;
    skos:exactMatch brreg_felles_digital_adresse:Nettadresse ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:Telefonnummer a owl:Class ;
    rdfs:label "Telefonnummer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:prefiks_med_nasjonal_kode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:nasjonalt_nummer ],
        brreg_felles_digital_adresse:DigitalAdresse ;
    skos:definition "Eit fasttelefonnummer." ;
    skos:exactMatch brreg_felles_digital_adresse:Telefonnummer ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:brukernavn a owl:DatatypeProperty ;
    rdfs:label "brukernavn" ;
    rdfs:range xsd:string ;
    skos:definition "Brukarnamnet (lokaldelen) i e-postadressa." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:digital_adresse_id a owl:DatatypeProperty ;
    rdfs:label "digital_adresse_id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI-identifikator for ressursen." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> ;
    skos:prefLabel "id" .

brreg_felles_digital_adresse:digital_adresse_type a owl:DatatypeProperty ;
    rdfs:label "digital_adresse_type" ;
    rdfs:range xsd:string ;
    skos:definition "Diskriminator for kva slag adresse dette er." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> ;
    skos:prefLabel "type" .

brreg_felles_digital_adresse:filsti a owl:DatatypeProperty ;
    rdfs:label "filsti" ;
    rdfs:range xsd:string ;
    skos:definition "Filstien i nettadressa." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:identifikator a owl:DatatypeProperty ;
    rdfs:label "identifikator" ;
    rdfs:range xsd:string ;
    skos:definition "Generisk identifikator (form varierer per samanheng — brukt både for digitale adresser og, via brreg-felles-aktoer, for aktørar generelt)." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:ip_nummer a owl:DatatypeProperty ;
    rdfs:label "ip_nummer" ;
    rdfs:range xsd:string ;
    skos:definition "IP-nummeret." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:meldingsbokstype a owl:DatatypeProperty ;
    rdfs:label "meldingsbokstype" ;
    rdfs:range xsd:string ;
    skos:definition "Kva type digital meldingsboks dette er (t.d. Altinn)." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:protokoll a owl:DatatypeProperty ;
    rdfs:label "protokoll" ;
    rdfs:range xsd:string ;
    skos:definition "Protokollen for nettadressa, t.d. https." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:domenenavn a owl:DatatypeProperty ;
    rdfs:label "domenenavn" ;
    rdfs:range xsd:string ;
    skos:definition "Domenenamnet i adressa." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:nasjonalt_nummer a owl:DatatypeProperty ;
    rdfs:label "nasjonalt_nummer" ;
    rdfs:range xsd:string ;
    skos:definition "Telefonnummeret utan landkode/prefiks." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:prefiks_med_nasjonal_kode a owl:DatatypeProperty ;
    rdfs:label "prefiks_med_nasjonal_kode" ;
    rdfs:range xsd:string ;
    skos:definition "Internasjonalt telefonprefiks (landkode), t.d. \"+47\"." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

brreg_felles_digital_adresse:DigitalAdresse a owl:Class ;
    rdfs:label "DigitalAdresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:digital_adresse_type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:digital_adresse_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_digital_adresse:identifikator ] ;
    skos:definition "Ei digital adresse. Abstrakt basisklasse for dei konkrete digitale adressetypane under." ;
    skos:exactMatch brreg_felles_digital_adresse:DigitalAdresse ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-digital-adresse> .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[2389][0-9]{8}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{11}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{11}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}$" ] ) ] .


