            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path brreg_felles_digital_adresse:identifikator ],
        [ sh:datatype xsd:string ;
            sh:description "Kva type digital meldingsboks dette er (t.d. Altinn)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
