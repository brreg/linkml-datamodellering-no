            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path brreg_felles_digital_adresse:id ] ;
    sh:targetClass brreg_felles_digital_adresse:IPAdresse .

brreg_felles_digital_adresse:Meldingsboks a sh:NodeShape ;
    rdfs:comment "Ei digital meldingsboks (t.d. Altinn)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Diskriminator for kva slag digital adresse dette er." ;
            sh:maxCount 1 ;
