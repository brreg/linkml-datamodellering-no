brreg_felles_digital_adresse:Mobiltelefonnummer a sh:NodeShape ;
    rdfs:comment "Eit mobiltelefonnummer." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Diskriminator for kva slag digital adresse dette er." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path brreg_felles_digital_adresse:type ],
        [ sh:description "URI-identifikator for ressursen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path brreg_felles_digital_adresse:id ],
        [ sh:datatype xsd:string ;
            sh:description "Internasjonalt telefonprefiks (landkode), t.d. \"+47\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path brreg_felles_digital_adresse:prefiksMedNasjonalKode ],
        [ sh:datatype xsd:string ;
            sh:description "Identifikator for den digitale adressa (form varierer per undertype)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path brreg_felles_digital_adresse:identifikator ],
        [ sh:datatype xsd:string ;
            sh:description "Telefonnummeret utan landkode/prefiks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path brreg_felles_digital_adresse:nasjonaltNummer ] ;
    sh:targetClass brreg_felles_digital_adresse:Mobiltelefonnummer .

