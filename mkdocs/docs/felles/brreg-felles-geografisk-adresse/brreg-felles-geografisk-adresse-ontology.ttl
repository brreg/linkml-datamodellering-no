<https://data.norge.no/felles/brreg-felles-geografisk-adresse.owl.ttl> a owl:Ontology ;
    rdfs:label "brreg-felles-geografisk-adresse" ;
    dcterms:license "https://data.norge.no/nlod/no/2.0" ;
    dcterms:title "BRREG felles geografisk adresse" ;
    pav:version "0.1.0" ;
    skos:definition "Gjenbrukbare geografiske adresseklassar utleia frå Brønnøysundregistrene (BR) sin interne BRReferansemodell_v3 (MagicDraw/XMI), pakken \"Adresse\" (GeografiskAdresse-hierarkiet), pluss dei adresse-relaterte komplekstypane frå Strukturtypekatalog_v1 (Poststed, Kommune, Fylke, Matrikkelnummer, Adressenummer) som adressehierarkiet er avhengig av. Sjå specs/done/felles-typar-enhetsregisteret-fra-br-katalogar.md for bakgrunn, metode og avklaringane denne modellen byggjer på." ;
    brreg_felles_geografisk_adresse:endringsdato "2026-09-01" ;
    brreg_felles_geografisk_adresse:status "http://purl.org/adms/status/UnderDevelopment" ;
    brreg_felles_geografisk_adresse:utgivelsesdato "2026-09-01" ;
    brreg_felles_geografisk_adresse:utgiver "https://data.norge.no/organizations/974760673" .

xsd:anyURI a rdfs:Datatype .

brreg_felles_geografisk_adresse:InternasjonalAdresse a owl:Class ;
    rdfs:label "InternasjonalAdresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:fri_adressetekst ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:adressenavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:boenhet ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:adresseidentifikator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:postboks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:by_eller_stedsnavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:adressenummer_tekst ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:postkode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:etasjenummer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:bygning ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:region ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:landkode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_geografisk_adresse:distrikt_eller_bydel ],
        brreg_felles_geografisk_adresse:GeografiskAdresse ;
    skos:definition "Ei adresse i eit anna land enn Noreg, i fri form." ;
    skos:exactMatch brreg_felles_geografisk_adresse:InternasjonalAdresse ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-geografisk-adresse> .

brreg_felles_geografisk_adresse:Matrikkeladresse a owl:Class ;
