            sh:path brreg_felles_geografisk_adresse:bruksenhetsnummer ],
        [ sh:class brreg_felles_geografisk_adresse:Matrikkelnummer ;
            sh:description "Matrikkelnummeret adressa er knytt til." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
