    {field} id(i) : uriorcurie  
    {field} identifikator(i) : string  
    {field} type(i) : string  
}
class "Mobiltelefonnummer" [[{Eit mobiltelefonnummer.}]] {
    {field} prefiks_med_nasjonal_kode : PrefiksMedNasjonalKode  
    {field} nasjonalt_nummer : NasjonaltNummer  
    {field} id(i) : uriorcurie  
    {field} identifikator(i) : string  
    {field} type(i) : string  
}
class "Meldingsboks" [[{Ei digital meldingsboks (t.d. Altinn).}]] {
    {field} meldingsbokstype : string  
    {field} id(i) : uriorcurie  
    {field} identifikator(i) : string  
    {field} type(i) : string  
}
class "IPAdresse" [[{Ei IP-adresse.}]] {
    {field} ip_nummer : string  
    {field} id(i) : uriorcurie  
    {field} identifikator(i) : string  
    {field} type(i) : string  
}
class "EPostadresse" [[{Ei e-postadresse, delt opp i brukarnamn og domenenavn.}]] {
    {field} domenenavn : string  
    {field} brukernavn : string  
    {field} id(i) : uriorcurie  
    {field} identifikator(i) : string  
    {field} type(i) : string  
}
"Aktoer" --> "0..1" "DigitalAdresse" : "digital_adresse"
"DigitalAdresse" ^-- "Telefonnummer"
"DigitalAdresse" ^-- "Nettadresse"
"DigitalAdresse" ^-- "Mobiltelefonnummer"
"DigitalAdresse" ^-- "Meldingsboks"
"DigitalAdresse" ^-- "IPAdresse"
"DigitalAdresse" ^-- "EPostadresse"
@enduml
