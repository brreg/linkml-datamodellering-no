@prefix brreg_felles_aktoer: <https://data.norge.no/felles/brreg-felles-aktoer/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rov: <http://www.w3.org/ns/regorg#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rov:RegisteredOrganization a sh:NodeShape ;
    rdfs:comment "Ei verksemd registrert i Einingsregisteret." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class brreg_felles_aktoer:Virksomhetsidentifikator ;
            sh:description "Identifikatoren for verksemda." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path brreg_felles_aktoer:virksomhetsidentifikator ],
        [ sh:datatype xsd:string ;
            sh:description "Organisasjonsnummeret til verksemda." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path brreg_felles_aktoer:organisasjonsnummer ;
            sh:pattern "^[2389][0-9]{8}$" ],
        [ sh:class brreg_felles_aktoer:Kontaktinformasjon ;
            sh:description "Kontaktinformasjon for aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path brreg_felles_aktoer:kontaktinformasjon ],
        [ sh:description "URI-identifikator for ressursen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://data.norge.no/felles/brreg-felles-geografisk-adresse/id> ],
        [ sh:datatype xsd:string ;
            sh:description "Generisk identifikator (form varierer per samanheng — brukt både for digitale adresser og, via brreg-felles-aktoer, for aktørar generelt)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/identifikator> ],
        [ sh:datatype xsd:string ;
            sh:description "Statusen til verksemda." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path brreg_felles_aktoer:virksomhetsstatus ],
        [ sh:class brreg_felles_aktoer:Rolle ;
            sh:description "Roller aktøren har." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path brreg_felles_aktoer:rolle ],
        [ sh:class brreg_felles_aktoer:Relasjon ;
            sh:description "Relasjonar aktøren har til andre aktørar." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path brreg_felles_aktoer:relasjon ],
        [ sh:class <https://data.norge.no/felles/brreg-felles-digital-adresse/DigitalAdresse> ;
            sh:description "Digital adresse knytt til aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path brreg_felles_aktoer:digitalAdresse ],
        [ sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:description "Geografisk adresse knytt til aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path brreg_felles_aktoer:geografiskAdresse ],
        [ sh:datatype xsd:string ;
            sh:description "Namnet på verksemda." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path brreg_felles_aktoer:virksomhetsnavn ] ;
    sh:targetClass rov:RegisteredOrganization .

foaf:Person a sh:NodeShape ;
    rdfs:comment "Ein fysisk person." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Statusen til personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path brreg_felles_aktoer:personstatus ],
        [ sh:class brreg_felles_aktoer:Relasjon ;
            sh:description "Relasjonar aktøren har til andre aktørar." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path brreg_felles_aktoer:relasjon ],
        [ sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:description "Geografisk adresse knytt til aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path brreg_felles_aktoer:geografiskAdresse ],
        [ sh:class brreg_felles_aktoer:Personidentifikator ;
            sh:description "Identifikatoren for personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path brreg_felles_aktoer:personidentifikator ],
        [ sh:datatype xsd:string ;
            sh:description "BR sin interne identifikator for personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path brreg_felles_aktoer:brPersonId ],
        [ sh:class brreg_felles_aktoer:Personnavn ;
            sh:description "Namnet på personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path brreg_felles_aktoer:personnavn ],
        [ sh:class brreg_felles_aktoer:Rolle ;
            sh:description "Roller aktøren har." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path brreg_felles_aktoer:rolle ],
        [ sh:datatype xsd:string ;
            sh:description "Statsborgarskapet til personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path brreg_felles_aktoer:statsborgerskap ],
        [ sh:datatype xsd:string ;
            sh:description "Generisk identifikator (form varierer per samanheng — brukt både for digitale adresser og, via brreg-felles-aktoer, for aktørar generelt)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/identifikator> ],
        [ sh:class <https://data.norge.no/felles/brreg-felles-digital-adresse/DigitalAdresse> ;
            sh:description "Digital adresse knytt til aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path brreg_felles_aktoer:digitalAdresse ],
        [ sh:description "URI-identifikator for ressursen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://data.norge.no/felles/brreg-felles-geografisk-adresse/id> ],
        [ sh:datatype xsd:string ;
            sh:description "Fødselsnummeret eller D-nummeret til personen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path brreg_felles_aktoer:foedselEllerDNummer ;
            sh:pattern "^[0-9]{11}$" ],
        [ sh:class brreg_felles_aktoer:Kontaktinformasjon ;
            sh:description "Kontaktinformasjon for aktøren/rolla." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path brreg_felles_aktoer:kontaktinformasjon ] ;
    sh:targetClass foaf:Person .

<https://data.norge.no/felles/brreg-felles-digital-adresse/EPostadresse> a sh:NodeShape ;
    rdfs:comment "Ei e-postadresse, delt opp i brukarnamn og domenenavn." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Diskriminator for kva slag digital adresse dette er." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/type> ],
        [ sh:description "URI-identifikator for ressursen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/id> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifikator for den digitale adressa (form varierer per undertype)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/identifikator> ],
        [ sh:datatype xsd:string ;
            sh:description "Domenenamnet i adressa." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/domenenavn> ],
        [ sh:datatype xsd:string ;
            sh:description "Brukarnamnet (lokaldelen) i e-postadressa." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://data.norge.no/felles/brreg-felles-digital-adresse/brukernavn> ] ;
    sh:targetClass <https://data.norge.no/felles/brreg-felles-digital-adresse/EPostadresse> .

