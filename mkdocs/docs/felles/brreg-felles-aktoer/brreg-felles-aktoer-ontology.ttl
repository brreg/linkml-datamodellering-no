xsd:base64Binary a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:gYear a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

xsd:hexBinary a rdfs:Datatype .

xsd:long a rdfs:Datatype .

xsd:negativeInteger a rdfs:Datatype .

xsd:nonNegativeInteger a rdfs:Datatype .

xsd:nonPositiveInteger a rdfs:Datatype .

xsd:positiveInteger a rdfs:Datatype .

xsd:short a rdfs:Datatype .

xsd:token a rdfs:Datatype .

<https://data.norge.no/felles/brreg-felles-aktoer.owl.ttl> a owl:Ontology ;
    rdfs:label "brreg-felles-aktoer" ;
    dcterms:license "https://data.norge.no/nlod/no/2.0" ;
    dcterms:title "BRREG felles aktør" ;
    pav:version "0.1.0" ;
    skos:definition "Gjenbrukbare aktørklassar (Aktør, Virksomhet, Person, Rolle m.fl.) utleia frå Brønnøysundregistrene (BR) sin interne BRReferansemodell_v3 (MagicDraw/XMI), pakken \"Aktør\", pluss dei aktør-relaterte komplekstypane frå Strukturtypekatalog_v1 (Personnavn, Personidentifikator, Virksomhetsidentifikator) som aktørklassane er avhengige av. Importerer brreg-felles-adresse for GeografiskAdresse/DigitalAdresse. Sjå specs/done/felles-typar-enhetsregisteret-fra-br-katalogar.md for bakgrunn, metode og avklaringane denne modellen byggjer på." ;
    brreg_felles_aktoer:endringsdato "2026-08-31" ;
    brreg_felles_aktoer:status "http://purl.org/adms/status/UnderDevelopment" ;
    brreg_felles_aktoer:utgivelsesdato "2026-08-31" ;
    brreg_felles_aktoer:utgiver "https://data.norge.no/organizations/974760673" .

brreg_felles_aktoer:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:statsborgerskap ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:personstatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:br_person_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:personnavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:personidentifikator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:foedsel_eller_d_nummer ],
        brreg_felles_aktoer:Aktoer ;
    skos:definition "Ein fysisk person." ;
    skos:exactMatch foaf:Person ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Virksomhet a owl:Class ;
    rdfs:label "Virksomhet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:organisasjonsnummer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:virksomhetsnavn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:virksomhetsstatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:virksomhetsidentifikator ],
        brreg_felles_aktoer:Aktoer ;
    skos:definition "Ei verksemd registrert i Einingsregisteret." ;
    skos:exactMatch rov:RegisteredOrganization ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:relasjon a owl:ObjectProperty ;
    rdfs:label "relasjon" ;
    rdfs:range brreg_felles_aktoer:Relasjon ;
    skos:definition "Relasjonar aktøren har til andre aktørar." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:rolle a owl:ObjectProperty ;
    rdfs:label "rolle" ;
    rdfs:range brreg_felles_aktoer:Rolle ;
    skos:definition "Roller aktøren har." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

xsd:anyURI a rdfs:Datatype .

