brreg_felles_aktoer:Kontaktinformasjon a owl:Class ;
    rdfs:label "Kontaktinformasjon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:digital_adresse ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:geografisk_adresse ] ;
    skos:definition "Kontaktinformasjon (digital og/eller geografisk adresse) for ein aktør." ;
    skos:exactMatch brreg_felles_aktoer:Kontaktinformasjon ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Personidentifikator a owl:Class ;
    rdfs:label "Personidentifikator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:verdi ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:personidentifikator_type ] ;
    skos:definition "Ein identifikator for ein person, med ein type som seier kva slag identifikator det er." ;
    skos:exactMatch brreg_felles_aktoer:Personidentifikator ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Personnavn a owl:Class ;
    rdfs:label "Personnavn" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:mellomnavn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:fornavn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:etternavn ] ;
    skos:definition "Fullt namn på ein person, delt opp i for-, mellom- og etternamn." ;
    skos:exactMatch brreg_felles_aktoer:Personnavn ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Relasjon a owl:Class ;
    rdfs:label "Relasjon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:aktoer ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/type> ] ;
    skos:definition "Ein relasjon mellom to aktørar." ;
    skos:exactMatch brreg_felles_aktoer:Relasjon ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Rolle a owl:Class ;
    rdfs:label "Rolle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:digital_adresse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:geografisk_adresse ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:kontaktinformasjon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:rolletypegruppe ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/type> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:rolleinnehaver ] ;
    skos:definition "Ei rolle ein aktør har overfor ein annan aktør (t.d. styreleiar, revisor)." ;
    skos:exactMatch brreg_felles_aktoer:Rolle ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Rolletypegruppe a owl:Class ;
    rdfs:label "Rolletypegruppe" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/type> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ] ;
    skos:definition "Ei gruppering av rolletypar (t.d. \"styre\")." ;
    skos:exactMatch brreg_felles_aktoer:Rolletypegruppe ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:Virksomhetsidentifikator a owl:Class ;
    rdfs:label "Virksomhetsidentifikator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:virksomhetsidentifikator_type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty brreg_felles_aktoer:verdi ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ] ;
    skos:definition "Ein identifikator for ei verksemd, med ein type som seier kva slag identifikator det er." ;
    skos:exactMatch brreg_felles_aktoer:Virksomhetsidentifikator ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:kontaktinformasjon a owl:ObjectProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:range brreg_felles_aktoer:Kontaktinformasjon ;
    skos:definition "Kontaktinformasjon for aktøren/rolla." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:verdi a owl:DatatypeProperty ;
    rdfs:label "verdi" ;
    rdfs:range xsd:string ;
    skos:definition "Verdien til identifikatoren." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

<https://data.norge.no/felles/brreg-felles-adresse/kommune> a owl:ObjectProperty ;
    rdfs:label "kommune" ;
    rdfs:range <https://data.norge.no/felles/brreg-felles-adresse/Kommune> ;
    skos:definition "Kommunen adressa ligg i." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

<https://data.norge.no/felles/brreg-felles-adresse/poststed> a owl:ObjectProperty ;
    rdfs:label "poststed" ;
    rdfs:range <https://data.norge.no/felles/brreg-felles-adresse/Poststed> ;
    skos:definition "Poststedet adressa høyrer til." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

<https://data.norge.no/felles/brreg-felles-aktoer/:VirksomhetsidentifikatorType> a owl:Class ;
    rdfs:label "VirksomhetsidentifikatorType" ;
    owl:unionOf ( <https://data.norge.no/felles/brreg-felles-aktoer/:VirksomhetsidentifikatorType#organisasjonsnummer> <https://data.norge.no/felles/brreg-felles-aktoer/:VirksomhetsidentifikatorType#utenlandsk_virksomhetsidentifikator> ) ;
    skos:definition "Kva slag verksemdsidentifikator ein Virksomhetsidentifikator inneheld." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> ;
    linkml:permissible_values <https://data.norge.no/felles/brreg-felles-aktoer/:VirksomhetsidentifikatorType#organisasjonsnummer>,
        <https://data.norge.no/felles/brreg-felles-aktoer/:VirksomhetsidentifikatorType#utenlandsk_virksomhetsidentifikator> .

brreg_felles_aktoer:digital_adresse a owl:ObjectProperty ;
    rdfs:label "digital_adresse" ;
    rdfs:range <https://data.norge.no/felles/brreg-felles-adresse/DigitalAdresse> ;
    skos:definition "Digital adresse knytt til aktøren/rolla." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

brreg_felles_aktoer:geografisk_adresse a owl:ObjectProperty ;
    rdfs:label "geografisk_adresse" ;
    rdfs:range <https://data.norge.no/felles/brreg-felles-adresse/GeografiskAdresse> ;
    skos:definition "Geografisk adresse knytt til aktøren/rolla." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

<https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType> a owl:Class ;
    rdfs:label "PersonidentifikatorType" ;
    owl:unionOf ( <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#foedselsnummer> <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#d_nummer> <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#utenlandsk_personidentifikator> ) ;
    skos:definition "Kva slag personidentifikator ein Personidentifikator inneheld." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> ;
    linkml:permissible_values <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#d_nummer>,
        <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#foedselsnummer>,
        <https://data.norge.no/felles/brreg-felles-aktoer/:PersonidentifikatorType#utenlandsk_personidentifikator> .

brreg_felles_aktoer:Aktoer a owl:Class ;
    rdfs:label "Aktoer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:geografisk_adresse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:kontaktinformasjon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/identifikator> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty brreg_felles_aktoer:digital_adresse ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ] ;
    skos:definition "Ein aktør — person eller verksemd. Abstrakt basisklasse for Virksomhet og Person." ;
    skos:exactMatch foaf:Agent ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-aktoer> .

xsd:integer a rdfs:Datatype .

<https://data.norge.no/felles/brreg-felles-adresse/type> a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "Diskriminator for kva slag adresse dette er." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

<https://data.norge.no/felles/brreg-felles-adresse/GeografiskAdresse> a owl:Class ;
    rdfs:label "GeografiskAdresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/type> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/br_adresse_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/co_navn> ] ;
    skos:definition "Ei geografisk adresse. Abstrakt basisklasse for dei konkrete adressetypane under." ;
    skos:exactMatch <http://www.w3.org/ns/locn#Address> ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

<https://data.norge.no/felles/brreg-felles-adresse/DigitalAdresse> a owl:Class ;
    rdfs:label "DigitalAdresse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/identifikator> ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://data.norge.no/felles/brreg-felles-adresse/type> ] ;
    skos:definition "Ei digital adresse. Abstrakt basisklasse for dei konkrete digitale adressetypane under." ;
    skos:exactMatch <https://data.norge.no/felles/brreg-felles-adresse/DigitalAdresse> ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

<https://data.norge.no/felles/brreg-felles-adresse/id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI-identifikator for ressursen." ;
    skos:inScheme <https://data.norge.no/felles/brreg-felles-adresse> .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{11}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{11}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]{3}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[2389][0-9]{8}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}$" ] ) ] .


