FROM python:3.11-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY src/mcp-linkml-validator/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /install /usr/local

# Kopier inn validerings-script (server.py, validate-and-log.py og policies/)
COPY src/mcp-linkml-validator/server.py src/mcp-linkml-validator/validate-and-log.py ./
COPY src/mcp-linkml-validator/policies/ policies/

RUN useradd -m mcp
USER mcp

CMD ["python", "server.py"]
