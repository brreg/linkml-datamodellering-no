FROM python:3.14-alpine AS builder

# Build format: Docker v2 (via --format docker flag in Makefile)
RUN apk add --no-cache --virtual .build-deps gcc musl-dev libffi-dev g++

RUN pip install --no-cache-dir --prefix=/install \
    "linkml==1.11.1" \
    rdflib


FROM python:3.14-alpine

RUN apk add --no-cache patch

COPY --from=builder /install /usr/local

# Patch LinkML docgen for lengre description i tabellar
COPY src/assets/containers/patches/docgen-max-chars.patch /tmp/
RUN patch /usr/local/lib/python3.11/site-packages/linkml/generators/docgen.py \
    < /tmp/docgen-max-chars.patch \
    && rm /tmp/docgen-max-chars.patch

WORKDIR /work
