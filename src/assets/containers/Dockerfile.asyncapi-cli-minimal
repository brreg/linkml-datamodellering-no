FROM node:24-alpine

LABEL org.opencontainers.image.title="AsyncAPI Validator (Minimal)"
LABEL org.opencontainers.image.description="Minimal AsyncAPI validator using only @asyncapi/parser (~296 MB vs 4.43 GB)"
LABEL org.opencontainers.image.source="https://github.com/brreg/linkml-datamodellering-no"
LABEL org.opencontainers.image.authors="Brønnøysundregistrene"

WORKDIR /app

# Install only the minimal required packages for AsyncAPI validation
# Drastically reduces image size from 4.43 GB to ~296 MB
RUN npm install --global --omit=dev \
    @asyncapi/parser@^3.6.0 \
    js-yaml@^4.1.1

# Set NODE_PATH to find globally installed modules
ENV NODE_PATH=/usr/local/lib/node_modules

# Copy minimal validation wrapper script
COPY src/assets/scripts/container/asyncapi-validate.js /usr/local/bin/asyncapi-validate
RUN chmod +x /usr/local/bin/asyncapi-validate

# Create a non-root user for security
RUN addgroup -S asyncapi && adduser -S asyncapi -G asyncapi
USER asyncapi

ENTRYPOINT [ "asyncapi-validate" ]
